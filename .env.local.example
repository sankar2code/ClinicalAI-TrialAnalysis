# Required — the reasoning pipeline cannot run without this.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — model override, defaults to claude-sonnet-5 (lib/clients/anthropic.ts)
ANTHROPIC_MODEL=

# Optional — raises PubMed E-utilities rate limit from 3 req/s to 10 req/s.
# https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Optional — evidence-packet caching (lib/cache.ts) and benchmark/eval/
# feedback storage (supabase/schema.sql) both no-op gracefully if unset.
# Project Settings > API in your Supabase dashboard. Use the service role
# key, not the anon key — these routes are server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — ships inactive. See lib/rateLimit.ts.
RATE_LIMIT_ENABLED=false
